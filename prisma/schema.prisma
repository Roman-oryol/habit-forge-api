generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Habit {
  id             String        @id @default(uuid())
  name           String
  createdAt      DateTime      @default(now())
  categoryId     String?
  frequencyDays  Int[]
  frequencyCount Int?
  frequencyType  FrequencyType
  completions    Completion[]
  category       Category?     @relation(fields: [categoryId], references: [id])

  @@map("habits")
}

model Category {
  id     String  @id @default(uuid())
  name   String
  habits Habit[]

  @@map("categories")
}

model Completion {
  id      String   @id @default(uuid())
  date    DateTime @db.Date
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("completions")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

enum FrequencyType {
  daily
  weekdays
  timesPerWeek
}
